# ============================================
# Serbian AI Tutor - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# ============================================
# Clerk Authentication (Required)
# ============================================
# Get these from: https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_JWT_ISSUER_DOMAIN="https://your-clerk-domain.clerk.accounts.dev"

# ============================================
# BOT Authentication 
# ============================================

BOT_AUTOMATION_KEY=irgendeinLangerZufallsstring123

# ============================================
# ============================================
# Get this from: https://dashboard.convex.dev
# Format: https://your-deployment.convex.cloud
VITE_CONVEX_URL="https://your-deployment.convex.cloud"
CONVEX_DEPLOYMENT="dev:your-deployment-name"

# ============================================
# ============================================

# ============================================
# AI/LLM Configuration
# ============================================
# Gemini API Key (for AI Learn Buddy)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Alternative: OpenAI (if not using Gemini)
OPENAI_API_KEY=""
OPENAI_API_URL=""

# Alternative: Built-in Forge API
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""

# ============================================
# Email Service (Resend)
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@mail.jacksenn.me"
RESEND_REPLY_TO_EMAIL="hello@jacksenn.me"
ADMIN_NOTIFICATION_EMAIL="hello@jacksenn.me"
# Webhook signing secret for Resend event verification (Svix).
# Get from: https://resend.com/webhooks -> your endpoint -> Signing Secret
# Set this in the Convex Dashboard (not needed locally unless testing webhooks).
RESEND_WEBHOOK_SECRET="whsec_..."

# ============================================
# App Configuration
# ============================================
# Landing page: waitlist CTA and "rolling out" copy. Omit or set to anything other than "on" to disable (recommended once beta is public).
# VITE_WAITLIST_MODE=on

VITE_APP_TITLE="Serbian AI Tutor"
VITE_APP_LOGO="https://placehold.co/128x128/3B82F6/FFFFFF?text=SAT"
VITE_APP_ID="proj_abc123def456"
VITE_OAUTH_PORTAL_URL="https://your-oauth-portal.com"

# Public site URL (used by the prerender script for canonical, og:url, og:image).
# On Vercel Production set this to the custom domain (e.g. https://learn-with.me).
# VITE_SITE_URL="https://learn-with.me"

# ============================================
# Billing (Dodo Payments)
# ============================================
# ---- Dodo Payments ----
# API key is server-only (Convex). Never expose in VITE_ env vars.
DODO_PAYMENTS_API_KEY="dp_..."
# Environment values used in docs/SDK: "test_mode" | "live_mode"
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Webhook signing secret (Standard Webhooks)
# Prefer DODO_PAYMENTS_WEBHOOK_SECRET; DODO_PAYMENTS_WEBHOOK_KEY is supported for backward compatibility.
DODO_PAYMENTS_WEBHOOK_SECRET="whsec_..."
# DODO_PAYMENTS_WEBHOOK_KEY="whsec_..."

# Dodo product IDs (from Dashboard or via dodo-migrate)
# Prepaid (one-time) products:
DODO_PRODUCT_INTENSIVE_PREPAID="pdt_..."
DODO_PRODUCT_BALANCED_PREPAID="pdt_..."
DODO_PRODUCT_STANDARD_PREPAID="pdt_..."
DODO_PRODUCT_RELAXED_PREPAID="pdt_..."
# Installments (subscription) products:
DODO_PRODUCT_INTENSIVE_INSTALLMENTS="pdt_..."
DODO_PRODUCT_BALANCED_INSTALLMENTS="pdt_..."
DODO_PRODUCT_STANDARD_INSTALLMENTS="pdt_..."
DODO_PRODUCT_RELAXED_INSTALLMENTS="pdt_..."

# NOTE (Upgrades):
# Upgrade payments are handled via auto-provisioned "top-up" products created in Dodo on demand.
# You do NOT need to configure additional upgrade product IDs here.

# Optional: one-time beta 50% discount code (server-only).
# This code should be restricted to the prepaid products above inside Dodo.
# If unset, beta discounts are treated as disabled.
DODO_BETA50_DISCOUNT_CODE=""

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV="development"

# ============================================
# Security & Authentication
# ============================================
JWT_SECRET="your-jwt-secret-change-in-production"
OWNER_OPEN_ID="your-owner-open-id"
# Email of the project owner -- auto-promoted to superadmin on login.
# Set this in the Convex Dashboard for both Dev and Prod.
OWNER_EMAIL="your-email@example.com"
# Shared secret for server-to-server TTS calls (optional fallback if Clerk auth unavailable).
TTS_API_SECRET="<random-secret-string>"

# ============================================
# Optional: AWS S3 (for file uploads)
# ============================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""

# ============================================
# Optional: Analytics
# ============================================
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""
VITE_FRONTEND_URL="http://localhost:3000"

# ============================================
# Google Cloud Text-to-Speech
# ============================================
# Service Account JSON (as single-line string)
# See docs/GOOGLE_CLOUD_TTS_SETUP.md for detailed setup instructions
# Get from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_CLOUD_SERVICE_ACCOUNT_KEY="<service-account-json>"
