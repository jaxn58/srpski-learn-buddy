# ============================================
# Serbian AI Tutor - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# ============================================
# Clerk Authentication (Required)
# ============================================
# Get these from: https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_JWT_ISSUER_DOMAIN="https://your-clerk-domain.clerk.accounts.dev"

# ============================================
# BOT Authentication 
# ============================================

BOT_AUTOMATION_KEY=irgendeinLangerZufallsstring123

# ============================================
# ============================================
# Get this from: https://dashboard.convex.dev
# Format: https://your-deployment.convex.cloud
VITE_CONVEX_URL="https://your-deployment.convex.cloud"
CONVEX_DEPLOYMENT="dev:your-deployment-name"

# ============================================
# ============================================

# ============================================
# AI/LLM Configuration
# ============================================
# Gemini API Key (for AI Learn Buddy)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Alternative: OpenAI (if not using Gemini)
OPENAI_API_KEY=""
OPENAI_API_URL=""

# Alternative: Built-in Forge API
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""

# ============================================
# Email Service (Resend)
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@mail.jacksenn.me"
RESEND_REPLY_TO_EMAIL="hello@jacksenn.me"
ADMIN_NOTIFICATION_EMAIL="hello@jacksenn.me"

# ============================================
# App Configuration
# ============================================
VITE_APP_TITLE="Serbian AI Tutor"
VITE_APP_LOGO="https://placehold.co/128x128/3B82F6/FFFFFF?text=SAT"
VITE_APP_ID="proj_abc123def456"
VITE_OAUTH_PORTAL_URL="https://your-oauth-portal.com"

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV="development"

# ============================================
# Security & Authentication
# ============================================
JWT_SECRET="your-jwt-secret-change-in-production"
OWNER_OPEN_ID="your-owner-open-id"

# ============================================
# Optional: AWS S3 (for file uploads)
# ============================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""

# ============================================
# Optional: Analytics
# ============================================
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""
VITE_FRONTEND_URL="http://localhost:3000"

# ============================================
# Google Cloud Text-to-Speech
# ============================================
# Service Account JSON (as single-line string)
# See docs/GOOGLE_CLOUD_TTS_SETUP.md for detailed setup instructions
# Get from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_CLOUD_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'
